# chave da api do gemini (aistudio.google.com) - embeddings e chat (fallback)
GEMINI_API_KEY=
# chave da api groq (console.groq.com) - fallback de chat e de embeddings
GROQ_API_KEY=
# chave do opencode zen (opencode.ai/zen) - provedor gratuito por tempo limitado
OPENCODE_ZEN_API_KEY=
# url do ollama (local ou servidor na nuvem) - embeddings e chat locais, zero cota
# para servidor na nuvem: http://seu-servidor-ip:11434/v1 ou https://seu-dominio:11434/v1
OLLAMA_URL=http://localhost:11434/v1
# credenciais de autenticação básica para ollama em servidor remoto (opcional)
OLLAMA_USERNAME=
OLLAMA_PASSWORD=
# url do seu worker do cloudflare workers ai (fallback de chat)
WORKERS_AI_URL=
WORKERS_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# origens permitidas de cors, separadas por virgula
CORS_ORIGINS=*

# ---- embeddings ----
# provedor principal de embeddings (ollama = local, gratuito, sem cota) e fallbacks
# - ollama: local, nomic-embed-text 768 dims — rode "ollama pull nomic-embed-text"
# - hf: nomic-embed-text-v1.5 gratis via api-inference (mesmo modelo do ollama)
#      — usado pelo backend on-line (Vercel) para embutir as consultas
# - gemini: via GEMINI_API_KEY (gemini-embedding-001)
# - groq: nomic-embed-text-v1.5 768 dims (via GROQ_API_KEY)
EMBEDDING_PROVIDER=ollama
EMBEDDING_FALLBACKS=hf,gemini,groq
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1.5
# modelo de embeddings gratuito do hugging face para consultas em produção
# (mesmo modelo nomic do ollama, 768 dims) - usado pelo backend quando on-line
HF_TOKEN=
HF_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# ---- llm (chat) ----
CHAT_MODEL=gemini-3.6-flash
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
OPENCODE_CHAT_MODEL=big-pickle
OLLAMA_CHAT_MODEL=qwen3:8b
# limite de tokens de saída por chamada do llm (raciocínio + resposta)
LLM_MAX_TOKENS=4096
# timeout (segundos) de cada chamada de rede ao llm (aguenta cold-start do workers ai)
LLM_TIMEOUT=300
# timeout (segundos) só da fase de conexão (TCP/TLS); falhas rápidas sobem o fallback mais cedo
LLM_CONNECT_TIMEOUT=20

# ---- base da api de dados abertos da camara ----
CAMARA_API_URL=https://dadosabertos.camara.leg.br/api/v2

# ---- postgres + pgvector (neon/supabase na camada gratuita) - fallback do índice RAG
# (usado por core/rag_pg.py só quando QDRANT_ENDPOINT não está definido)
DATABASE_URL=postgresql://

# ---- qdrant (índice vetorial principal, camada gratuita: 4GB de disco) ----
# padronize aqui: embeddings gerados localmente (ollama) e armazenados no Qdrant.
# Quando QDRANT_ENDPOINT + QDRANT_API_KEY estão definidos, core/rag.py usa o Qdrant.
# Endpoint atual costuma estar "suspenso" após ~1 semana inativo — dê "Resume"
# no cloud.qdrant.io antes de ingerir/consultar.
QDRANT_ENDPOINT=
QDRANT_API_KEY=
# nome da coleção (padrão: proposicoes)
QDRANT_COLECAO=proposicoes

# ---- rag ----
# quantos documentos recuperar por pergunta (aumente para mais resultados relevantes)
RAG_TOP_K=20
# primeiro ano coberto pela ingestão padrão
RAG_ANOS_DE=2016